# ─── ParkTwin AI — apps/web environment ───────────────────────
# Copy to `.env.local` for local overrides. All values are inlined at build time
# because they use the NEXT_PUBLIC_ prefix.

# Base URL of the ParkTwin backend (FastAPI). The integration gateway (/integration/*)
# is the preferred external surface — see PROJECT_MEMORY.md §7.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Human-readable application name shown in the shell/header.
NEXT_PUBLIC_APP_NAME=ParkTwin AI

# Axios request timeout (ms).
NEXT_PUBLIC_API_TIMEOUT=15000

# Default page size for paginated backend responses.
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
