# ===========================================================================
# ParkTwin AI — Production backend environment (loaded by docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# This is the file referenced by `env_file` in docker/compose/docker-compose.prod.yml.
# It is a TEMPLATE with placeholder/example values — replace SECRET_KEY and any
# credentials before deploying. No live secrets are committed.
#
# The reverse proxy serves the frontend and strips the `/api` prefix, forwarding
# /api/* to this backend. The backend therefore sees its normal routes
# (/integration, /health, /analytics, /reports, …) and needs no code changes.
# ===========================================================================

# ─── Environment & logging ──────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── Security ───────────────────────────────────────────────────────────────
# MUST be overridden with a strong random value in your real deployment.
SECRET_KEY=__GENERATE_A_LONG_RANDOM_STRING__

# ─── Database ───────────────────────────────────────────────────────────────
# Default SQLite backend (named volume):
DATABASE_URL=sqlite+aiosqlite:///./data/parktwin.db

# For PostgreSQL mode (e.g. docker-compose --profile postgres):
#   POSTGRES_USER=parktwin
#   POSTGRES_PASSWORD=parktwin_secret
#   POSTGRES_DB=parktwin_db
#   DATABASE_URL=postgresql+asyncpg://parktwin:parktwin_secret@db:5432/parktwin_db

# ─── Redis + event bus (optional) ───────────────────────────────────────────
REDIS_URL=redis://cache:6379/0
INTEGRATION_EVENT_BUS=memory

# ─── Bind address inside the container ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Log directory (mounted as a volume so logs persist + rotate) ───────────
LOG_DIR=/app/backend/logs
