# ─── ParkTwin AI — Module 1 (Vehicle Recognition & ANPR) ───────────────────────
# Copy to .env and fill values. All are optional; configs/settings.yaml provides defaults.

# ─── Database ──────────────────────────────────────────────────────────────────
# Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://parktwin:parktwin_secret@localhost:5432/parktwin_db
# Local dev without Postgres (zero-dependency):
# DATABASE_URL=sqlite+aiosqlite:///./parktwin.db

# ─── Redis (reserved for the future Integration Layer module) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ─── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_HOST=0.0.0.0
API_PORT=8000
