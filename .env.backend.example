# ===========================================================================
# ParkTwin AI — Backend environment (example / template)
# ---------------------------------------------------------------------------
# Copy to `.env` for local/container runs, or reference from docker compose
# via `env_file`. No live secrets are committed; replace the placeholder values.
#
# The settings loader reads ONLY the variables below from the environment
# (everything else comes from configs/settings.yaml). See docs/deployment/
# environment-variables.md.
# ===========================================================================

# ─── Environment ────────────────────────────────────────────────────────────
# development | production  (controls debug behaviour + the SECRET_KEY warning)
ENVIRONMENT=production

# ─── Logging ────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR  — NEVER DEBUG in production.
LOG_LEVEL=INFO

# ─── Security ───────────────────────────────────────────────────────────────
# Generate a strong value, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=__GENERATE_A_LONG_RANDOM_STRING__

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (single process, default — file persisted on a volume in Docker):
DATABASE_URL=sqlite+aiosqlite:///./data/parktwin.db
# PostgreSQL (multi-worker / concurrent writers — recommended for scale):
# DATABASE_URL=postgresql+asyncpg://parktwin:STRONG_PASSWORD@db:5432/parktwin_db

# ─── Redis (optional, for the redis event bus) ─────────────────────────────
REDIS_URL=redis://cache:6379/0

# ─── Integration event bus ──────────────────────────────────────────────────
# memory  (single process, default) | redis  (requires REDIS_URL + a Redis service)
INTEGRATION_EVENT_BUS=memory

# ─── Bind address (inside the container) ────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
