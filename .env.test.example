# ===========================================================================
# ParkTwin AI — Test backend environment (example / template)
# ---------------------------------------------------------------------------
# Values suitable for running the backend test suite (pytest). The suite
# regenerates test_parktwin.db each run (gitignored). Mirrors .env.backend.example
# but pins a non-debug, isolated configuration for CI / local testing.
# ===========================================================================

ENVIRONMENT=test
LOG_LEVEL=WARNING
SECRET_KEY=test-secret-key-not-for-production
DATABASE_URL=sqlite+aiosqlite:///./test_parktwin.db
REDIS_URL=redis://localhost:6379/0
INTEGRATION_EVENT_BUS=memory
API_HOST=127.0.0.1
API_PORT=8000
