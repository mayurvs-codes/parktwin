# Normalize line endings to LF in repo; checkout as native on each OS
* text=auto

# Explicitly force LF for scripts and source files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf

# Binary files — do not mangle
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.pt binary
*.mp4 binary
*.avi binary
*.mov binary
*.mkv binary
*.webm binary
