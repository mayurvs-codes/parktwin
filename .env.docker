# ===========================================================================
# ParkTwin AI — Docker environment
# ---------------------------------------------------------------------------
# Separates containerized configuration from local development (.env.example).
# Only the overrides needed for running in a container are listed; all other
# defaults live in configs/settings.yaml.
# ===========================================================================

ENVIRONMENT=development

# SQLite (aiosqlite) — stored in named volume so data persists between restarts.
DATABASE_URL=sqlite+aiosqlite:////app/data/parktwin.db

# Bind address / port for the containerized uvicorn process.
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO

# Replace before any production deployment.
SECRET_KEY=change-me-in-production
